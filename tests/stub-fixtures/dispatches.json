  "smoke": [
    { "desc": "dispatches/list-dispatches.sh (página única)",
      "cmd": "./dispatches/scripts/list-dispatches.sh stub-key --limit 2",
      "expect_out": "OMP-CAMPANHA DRAFT", "expect_exit": 0 },
    { "desc": "dispatches/list-dispatches.sh --all (2 páginas)",
      "cmd": "./dispatches/scripts/list-dispatches.sh stub-key --all --limit 2",
      "expect_out": "3 disparo(s).", "expect_exit": 0 },
    { "desc": "dispatches/list-dispatches.sh --search",
      "cmd": "./dispatches/scripts/list-dispatches.sh stub-key --search OMP-CAMPANHA --limit 1",
      "expect_out": "1 disparo(s).", "expect_exit": 0 },
    { "desc": "dispatches/list-dispatches.sh CV_JSON=1 (somente JSON)",
      "cmd": "CV_JSON=1 ./dispatches/scripts/list-dispatches.sh stub-key --limit 2 | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d[\"dispatches\"][0][\"id\"]==\"dispatch-1\"; print(\"JSON_OK\")'",
      "expect_out": "JSON_OK", "expect_exit": 0 },
    { "desc": "dispatches/list-dispatches.sh --limit inválido -> exit 1",
      "cmd": "./dispatches/scripts/list-dispatches.sh stub-key --limit abc",
      "expect_out": "--limit deve ser um número inteiro", "expect_exit": 1 },
    { "desc": "dispatches/list-dispatches.sh erro 500 -> exit 5",
      "cmd": "./dispatches/scripts/list-dispatches.sh stub-key --status INTERNAL --limit 4",
      "expect_out": "erro interno do servidor", "expect_exit": 5 },
    { "desc": "dispatches/create-dispatch.sh exige --yes",
      "cmd": "./dispatches/scripts/create-dispatch.sh stub-key --name X --agent agent-1",
      "expect_out": "--yes é obrigatório", "expect_exit": 1 },
    { "desc": "dispatches/create-dispatch.sh exige --agent",
      "cmd": "./dispatches/scripts/create-dispatch.sh stub-key --name X --yes",
      "expect_out": "--agent é obrigatório", "expect_exit": 1 },
    { "desc": "dispatches/create-dispatch.sh --yes (POST /dispatches)",
      "cmd": "./dispatches/scripts/create-dispatch.sh stub-key --name OMP-CAMPANHA --agent agent-1 --contact-list list-1 --yes",
      "expect_out": "dispatch-new", "expect_exit": 0 },
    { "desc": "dispatches/delete-dispatch.sh (busca na listagem + DELETE)",
      "cmd": "./dispatches/scripts/delete-dispatch.sh stub-key dispatch-2",
      "expect_out": "Disparo dispatch-2 deletado.", "expect_exit": 0 },
    { "desc": "dispatches/delete-dispatch.sh id inexistente -> exit 1",
      "cmd": "./dispatches/scripts/delete-dispatch.sh stub-key dispatch-inexistente",
      "expect_out": "não encontrado", "expect_exit": 1 },
    { "desc": "dispatches/populate-queue.sh exige --yes",
      "cmd": "./dispatches/scripts/populate-queue.sh stub-key dispatch-2",
      "expect_out": "--yes é obrigatório", "expect_exit": 1 },
    { "desc": "dispatches/populate-queue.sh --yes (POST populate-queue)",
      "cmd": "./dispatches/scripts/populate-queue.sh stub-key dispatch-2 --yes",
      "expect_out": "envios na fila: 3", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh list",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key list --limit 2",
      "expect_out": "list-1", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh list --all",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key list --all --limit 2",
      "expect_out": "lista(s) de contatos.", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh create",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key create --name 'Lista Nova'",
      "expect_out": "list-9", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh create sem --name -> exit 1",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key create",
      "expect_out": "--name é obrigatório em create", "expect_exit": 1 },
    { "desc": "dispatches/contact-lists.sh update (PUT, rota dedicada)",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key update list-1 --name 'Leads Outubro 2026'",
      "expect_out": "Lista de contatos atualizada", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh update --post (upsert)",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key update list-1 --name Renomeada --post",
      "expect_out": "Lista de contatos atualizada", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh delete",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key delete list-1",
      "expect_out": "deleted successfully", "expect_exit": 0 },
    { "desc": "dispatches/contact-lists.sh subcomando inválido -> exit 1",
      "cmd": "./dispatches/scripts/contact-lists.sh stub-key explodir",
      "expect_out": "subcomando desconhecido", "expect_exit": 1 },
    { "desc": "dispatches/list-contacts.sh sem --list -> exit 1",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key",
      "expect_out": "contactListId", "expect_exit": 1 },
    { "desc": "dispatches/list-contacts.sh list --limit 2",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key --list list-1 --limit 2",
      "expect_out": "Fulano Stub", "expect_exit": 0 },
    { "desc": "dispatches/list-contacts.sh list --all (2 páginas)",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key list --list list-1 --all --limit 2",
      "expect_out": "3 contato(s).", "expect_exit": 0 },
    { "desc": "dispatches/list-contacts.sh list de lista vazia",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key --list list-vazia --limit 2",
      "expect_out": "Nenhum contato encontrado", "expect_exit": 0 },
    { "desc": "dispatches/list-contacts.sh get",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key get contact-1",
      "expect_out": "Leads Outubro", "expect_exit": 0 },
    { "desc": "dispatches/list-contacts.sh get inexistente -> exit 1 (404)",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key get desconhecido",
      "expect_out": "não encontrado", "expect_exit": 1 },
    { "desc": "dispatches/list-contacts.sh add sem --phone -> exit 1",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key add --list list-1 --name X",
      "expect_out": "--phone é obrigatório", "expect_exit": 1 },
    { "desc": "dispatches/list-contacts.sh add",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key add --list list-1 --name 'Novo Stub' --phone 5511900000009",
      "expect_out": "contact-9", "expect_exit": 0 },
    { "desc": "dispatches/list-contacts.sh delete",
      "cmd": "./dispatches/scripts/list-contacts.sh stub-key delete contact-1",
      "expect_out": "deleted successfully", "expect_exit": 0 },
    { "desc": "dispatches/link-contacts.sh inclui lista",
      "cmd": "./dispatches/scripts/link-contacts.sh stub-key --dispatch dispatch-2 --list list-1",
      "expect_out": "Link created or updated successfully.", "expect_exit": 0 },
    { "desc": "dispatches/link-contacts.sh exclui lista",
      "cmd": "./dispatches/scripts/link-contacts.sh stub-key --dispatch dispatch-2 --list list-2 --exclude",
      "expect_out": "vínculo: exclusão", "expect_exit": 0 },
    { "desc": "dispatches/link-contacts.sh sem --list -> exit 1",
      "cmd": "./dispatches/scripts/link-contacts.sh stub-key --dispatch dispatch-2",
      "expect_out": "--list é obrigatório", "expect_exit": 1 }
  ],
  "live": [
    { "desc": "live dispatches/list-dispatches.sh --limit 2",
      "cmd": "./dispatches/scripts/list-dispatches.sh \"$CHATVOLT_API_KEY\" --limit 2 >/dev/null",
      "expect_exit": 0 },
    { "desc": "live dispatches/contact-lists.sh list --limit 2",
      "cmd": "./dispatches/scripts/contact-lists.sh \"$CHATVOLT_API_KEY\" list --limit 2 >/dev/null",
      "expect_exit": 0 },
    { "desc": "live dispatches/list-contacts.sh (lista inexistente -> vazio)",
      "cmd": "./dispatches/scripts/list-contacts.sh \"$CHATVOLT_API_KEY\" --list 00000000-0000-4000-8000-000000000000 --limit 1 >/dev/null",
      "expect_exit": 0 }
  ]
}
