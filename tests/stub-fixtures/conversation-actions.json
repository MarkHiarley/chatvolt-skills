{
  "skill": "conversation-actions",
  "routes": [
    { "method": "POST", "path": "/conversations/conv-api-1/assign",
      "status": 200, "body": { "success": true, "message": "Conversation Assigned." } },
    { "method": "POST", "path": "/conversations/conv-api-1/unassign",
      "status": 200, "body": { "success": true, "message": "Conversation unassigned." } },
    { "method": "POST", "path": "/conversations/conv-api-1/set-status",
      "status": 200, "body": { "success": true, "message": "Conversation Status changed." } },
    { "method": "POST", "path": "/conversations/conv-api-1/set-priority",
      "status": 200, "body": { "success": true, "message": "Conversation Priority changed." } },
    { "method": "POST", "path": "/conversations/conv-api-1/set-ai-enabled",
      "status": 200, "body": { "success": true, "message": "AI is On." } },
    { "method": "POST", "path": "/conversations/conv-404/set-status",
      "status": 404, "body": { "error": "NOT_FOUND" } },
    { "method": "POST", "path": "/conversations/conv-quota/set-priority",
      "status": 402, "body": { "error": { "message": "Limite de uso mensal atingido.", "code": "QUOTA_EXCEEDED" } } },

    { "method": "GET", "path": "/conversations/conv-api-1/notes",
      "status": 200,
      "body": [
        { "id": "note-1", "note": "Cliente pediu reembolso por e-mail", "userEmail": "atendente@exemplo.test",
          "isPrivate": false, "conversationId": "conv-api-1", "organizationId": "org-stub",
          "createdAt": "2026-10-11T10:00:00.000Z", "updatedAt": "2026-10-11T10:00:00.000Z",
          "notificationDateTime": null, "isJustification": false }
      ] },
    { "method": "POST", "path": "/conversations/conv-api-1/notes",
      "status": 201,
      "body": { "id": "note-2", "note": "nota nova criada pelo stub", "userEmail": "atendente@exemplo.test",
                "isPrivate": false, "conversationId": "conv-api-1", "organizationId": "org-stub",
                "createdAt": "2026-10-12T12:00:00.000Z", "updatedAt": "2026-10-12T12:00:00.000Z",
                "notificationDateTime": null, "isJustification": false } },
    { "method": "PUT", "path": "/conversations/conv-api-1/notes/note-1",
      "status": 200,
      "body": { "id": "note-1", "note": "Cliente pediu reembolso por e-mail (editada)",
                "isPrivate": false, "conversationId": "conv-api-1",
                "createdAt": "2026-10-11T10:00:00.000Z", "updatedAt": "2026-10-12T12:05:00.000Z" } },
    { "method": "DELETE", "path": "/conversations/conv-api-1/notes/note-1",
      "status": 204, "body": null },

    { "method": "GET", "path": "/conversations/conv-api-1/tags",
      "status": 401, "body": { "error": "Usuário não autenticado ou organização não encontrada." } },
    { "method": "POST", "path": "/conversations/conv-api-1/tags",
      "status": 401, "body": { "error": "Usuário não autenticado ou organização não encontrada." } },

    { "method": "POST", "path": "/variables",
      "status": 200, "body": { "conversationId": "conv-api-1", "varName": "nome_cliente", "varValue": "Albertina",
                               "createdAt": "2026-10-12T12:00:00.000Z", "updatedAt": "2026-10-12T12:00:00.000Z" } },
    { "method": "GET", "path": "/variables/conv-api-1",
      "status": 200,
      "body": [
        { "conversationId": "conv-api-1", "varName": "nome_cliente", "varValue": "Albertina",
          "createdAt": "2026-10-12T12:00:00.000Z", "updatedAt": "2026-10-12T12:00:00.000Z" }
      ] },
    { "method": "GET", "path": "/variables/conv-api-1/nome_cliente",
      "status": 200, "body": { "conversationId": "conv-api-1", "varName": "nome_cliente", "varValue": "Albertina",
                               "createdAt": "2026-10-12T12:00:00.000Z", "updatedAt": "2026-10-12T12:00:00.000Z" } },
    { "method": "DELETE", "path": "/variables/conv-api-1/nome_cliente",
      "status": 200, "body": { "message": "Variable successfully deleted",
                               "deleted": { "conversationId": "conv-api-1", "varName": "nome_cliente", "varValue": "Albertina" } } },
    { "method": "GET", "path": "/variables/conv-erro",
      "status": 500, "body": { "error": "INTERNAL" } },

    { "method": "POST", "path": "/conversations/conv-api-1/message-register",
      "status": 200, "body": { "success": true, "message": { "id": "msg-reg-1", "content": "evento externo registrado" } } },

    { "method": "POST", "path": "/conversation/message/conversationId/conv-api-1",
      "status": 200, "body": { "success": true, "message": { "id": "msg-send-1" } } },
    { "method": "POST", "path": "/conversation/message/phone/5511900000000",
      "status": 200, "body": { "success": true, "message": { "id": "msg-send-2" } } },
    { "method": "POST", "path": "/conversations/conv-api-1/send-audio",
      "status": 200, "body": { "data": { "messageId": "msg-audio-1", "status": "sent" }, "success": true, "error": null } },

    { "method": "GET", "path": "/conversations/conv-api-1/export",
      "status": 200, "raw": "id,canal,mensagem\nconv-api-1,api,Bom dia\n" },

    { "method": "GET", "path": "/conversations/history",
      "status": 200,
      "body": { "conversations": [
                  { "id": "conv-api-1", "channel": "api", "status": "UNRESOLVED",
                    "createdAt": "2026-10-10T12:00:00.000Z", "updatedAt": "2026-10-10T12:05:00.000Z" } ],
                "nextCursor": null, "email": "cliente@exemplo.test", "agentId": "agent-1" } }
  ],
  "smoke": [
    { "desc": "assign.sh atribui por e-mail", "cmd": "./conversation-actions/scripts/assign.sh stub-key conv-api-1 --email atendente@exemplo.test",
      "expect_out": "Conversation Assigned.", "expect_exit": 0 },
    { "desc": "unassign.sh remove o atendente", "cmd": "./conversation-actions/scripts/unassign.sh stub-key conv-api-1",
      "expect_out": "Conversation unassigned.", "expect_exit": 0 },
    { "desc": "set-status.sh muda para RESOLVED", "cmd": "./conversation-actions/scripts/set-status.sh stub-key conv-api-1 resolved",
      "expect_out": "Conversation Status changed.", "expect_exit": 0 },
    { "desc": "set-priority.sh muda para HIGH", "cmd": "./conversation-actions/scripts/set-priority.sh stub-key conv-api-1 high",
      "expect_out": "Conversation Priority changed.", "expect_exit": 0 },
    { "desc": "set-ai-enabled.sh liga a IA", "cmd": "./conversation-actions/scripts/set-ai-enabled.sh stub-key conv-api-1 on",
      "expect_out": "AI is On.", "expect_exit": 0 },

    { "desc": "notes.sh --action list", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action list",
      "expect_out": "note-1", "expect_exit": 0 },
    { "desc": "notes.sh --action create", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action create --note \"nota nova criada pelo stub\"",
      "expect_out": "note-2", "expect_exit": 0 },
    { "desc": "notes.sh --action update (PUT)", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action update --note-id note-1 --note \"Cliente pediu reembolso por e-mail (editada)\"",
      "expect_out": "(editada)", "expect_exit": 0 },
    { "desc": "notes.sh --action delete (204 sem corpo)", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action delete --note-id note-1",
      "expect_out": "apagada", "expect_exit": 0 },

    { "desc": "variables.sh list", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-api-1 list",
      "expect_out": "nome_cliente = Albertina", "expect_exit": 0 },
    { "desc": "variables.sh get", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-api-1 get --name nome_cliente",
      "expect_out": "nome_cliente = Albertina", "expect_exit": 0 },
    { "desc": "variables.sh set (upsert)", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-api-1 set --name nome_cliente --value Albertina",
      "expect_out": "nome_cliente = Albertina", "expect_exit": 0 },
    { "desc": "variables.sh delete", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-api-1 delete --name nome_cliente",
      "expect_out": "Variable successfully deleted", "expect_exit": 0 },

    { "desc": "message-register.sh registra sem enviar", "cmd": "./conversation-actions/scripts/message-register.sh stub-key conv-api-1 --message \"Cliente solicitou reembolso via e-mail\" --from agent",
      "expect_out": "mensagem registrada", "expect_exit": 0 },

    { "desc": "send-message.sh com --yes (conversationId)", "cmd": "./conversation-actions/scripts/send-message.sh stub-key --conversation-id conv-api-1 --message \"Olá! Como posso ajudar?\" --yes",
      "expect_out": "mensagem enviada", "expect_exit": 0 },
    { "desc": "send-message.sh com --yes (phone + channel)", "cmd": "./conversation-actions/scripts/send-message.sh stub-key --phone 5511900000000 --message \"Olá!\" --channel whatsapp --yes",
      "expect_out": "mensagem enviada", "expect_exit": 0 },
    { "desc": "send-audio.sh com --yes", "cmd": "./conversation-actions/scripts/send-audio.sh stub-key conv-api-1 --audio-url https://exemplo.test/audio.mp3 --duration 30 --yes",
      "expect_out": "áudio enviado", "expect_exit": 0 },

    { "desc": "export-conversation.sh --out (binário)", "cmd": "rm -f /tmp/cv-export-stub.txt && ./conversation-actions/scripts/export-conversation.sh stub-key conv-api-1 --out /tmp/cv-export-stub.txt",
      "expect_out": "cv-export-stub.txt", "expect_exit": 0 },

    { "desc": "history.sh por e-mail + agentId", "cmd": "./conversation-actions/scripts/history.sh stub-key --email cliente@exemplo.test --agent-id agent-1",
      "expect_out": "conv-api-1", "expect_exit": 0 },

    { "desc": "tags.sh list (401: exige sessão do dashboard)", "cmd": "./conversation-actions/scripts/tags.sh stub-key conv-api-1 list",
      "expect_out": "exige a sessão do dashboard", "expect_exit": 1 },
    { "desc": "tags.sh add (401: exige sessão do dashboard)", "cmd": "./conversation-actions/scripts/tags.sh stub-key conv-api-1 add --tag vip",
      "expect_out": "exige a sessão do dashboard", "expect_exit": 1 },

    { "desc": "assign.sh sem destinatário (validação)", "cmd": "./conversation-actions/scripts/assign.sh stub-key conv-api-1",
      "expect_out": "informe exatamente um destinatário", "expect_exit": 1 },
    { "desc": "assign.sh com dois destinatários (validação)", "cmd": "./conversation-actions/scripts/assign.sh stub-key conv-api-1 --email a@b.com --id u-1",
      "expect_out": "informe exatamente um destinatário", "expect_exit": 1 },
    { "desc": "unassign.sh sem conversation-id (validação)", "cmd": "./conversation-actions/scripts/unassign.sh stub-key",
      "expect_out": "informe o <conversation-id>", "expect_exit": 1 },
    { "desc": "set-status.sh com status inválido (validação)", "cmd": "./conversation-actions/scripts/set-status.sh stub-key conv-api-1 PENDING",
      "expect_out": "status inválido", "expect_exit": 1 },
    { "desc": "set-priority.sh com prioridade inválida (validação)", "cmd": "./conversation-actions/scripts/set-priority.sh stub-key conv-api-1 URGENT",
      "expect_out": "prioridade inválida", "expect_exit": 1 },
    { "desc": "set-ai-enabled.sh com estado inválido (validação)", "cmd": "./conversation-actions/scripts/set-ai-enabled.sh stub-key conv-api-1 talvez",
      "expect_out": "estado inválido", "expect_exit": 1 },
    { "desc": "notes.sh create sem --note (validação)", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action create",
      "expect_out": "exige --note", "expect_exit": 1 },
    { "desc": "notes.sh update sem --note-id (validação)", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action update --note x",
      "expect_out": "exige --note-id", "expect_exit": 1 },
    { "desc": "notes.sh com --action inválido (validação)", "cmd": "./conversation-actions/scripts/notes.sh stub-key conv-api-1 --action rename",
      "expect_out": "subcomando inválido", "expect_exit": 1 },
    { "desc": "tags.sh add sem --tag (validação)", "cmd": "./conversation-actions/scripts/tags.sh stub-key conv-api-1 add",
      "expect_out": "obrigatório no subcomando add", "expect_exit": 1 },
    { "desc": "variables.sh set sem --value (validação)", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-api-1 set --name nome_cliente",
      "expect_out": "exige --value", "expect_exit": 1 },
    { "desc": "variables.sh com varName acima de 20 caracteres (validação)", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-api-1 get --name abcdefghijklmnopqrstu",
      "expect_out": "no máximo 20", "expect_exit": 1 },
    { "desc": "message-register.sh sem --message (validação)", "cmd": "./conversation-actions/scripts/message-register.sh stub-key conv-api-1",
      "expect_out": "informe --message", "expect_exit": 1 },
    { "desc": "send-message.sh sem --yes (bloqueio de envio real)", "cmd": "./conversation-actions/scripts/send-message.sh stub-key --conversation-id conv-api-1 --message oi",
      "expect_out": "ENVIA uma mensagem REAL", "expect_exit": 1 },
    { "desc": "send-message.sh com --phone sem agent/channel (validação)", "cmd": "./conversation-actions/scripts/send-message.sh stub-key --phone 5511900000000 --message oi --yes",
      "expect_out": "exige --agent-id ou --channel", "expect_exit": 1 },
    { "desc": "send-audio.sh sem --yes (bloqueio de envio real)", "cmd": "./conversation-actions/scripts/send-audio.sh stub-key conv-api-1 --audio-url https://exemplo.test/a.mp3",
      "expect_out": "ENVIA um ÁUDIO REAL", "expect_exit": 1 },
    { "desc": "send-audio.sh com --duration não numérica (validação)", "cmd": "./conversation-actions/scripts/send-audio.sh stub-key conv-api-1 --audio-url https://exemplo.test/a.mp3 --duration abc --yes",
      "expect_out": "número inteiro", "expect_exit": 1 },
    { "desc": "export-conversation.sh sem conversation-id (validação)", "cmd": "./conversation-actions/scripts/export-conversation.sh stub-key",
      "expect_out": "informe o <conversation-id>", "expect_exit": 1 },
    { "desc": "history.sh sem --agent-id (validação)", "cmd": "./conversation-actions/scripts/history.sh stub-key --email cliente@exemplo.test",
      "expect_out": "informe --agent-id", "expect_exit": 1 },

    { "desc": "set-status.sh conversa inexistente (erro de API 404)", "cmd": "./conversation-actions/scripts/set-status.sh stub-key conv-404 RESOLVED",
      "expect_out": "HTTP 404", "expect_exit": 1 },
    { "desc": "set-priority.sh quota esgotada (erro de API 402)", "cmd": "./conversation-actions/scripts/set-priority.sh stub-key conv-quota LOW",
      "expect_out": "HTTP 402", "expect_exit": 3 },
    { "desc": "variables.sh erro interno do servidor (erro de API 500)", "cmd": "./conversation-actions/scripts/variables.sh stub-key conv-erro list",
      "expect_out": "HTTP 500", "expect_exit": 5 }
  ],
  "live": [
    { "desc": "live history.sh (leitura real por e-mail + agentId)",
      "cmd": "./conversation-actions/scripts/history.sh \"$CHATVOLT_API_KEY\" --email contato@exemplo.com --agent-id \"$CHATVOLT_AGENT_ID\"",
      "expect_exit": 0 },
    { "desc": "live tags.sh list (401 real: o endpoint não aceita API key)",
      "cmd": "./conversation-actions/scripts/tags.sh \"$CHATVOLT_API_KEY\" nao-existe list",
      "expect_out": "401", "expect_exit": 1 },
    { "desc": "live variables.sh list (precisa CHATVOLT_CONVERSATION_ID)",
      "cmd": "if [ -n \"${CHATVOLT_CONVERSATION_ID:-}\" ]; then ./conversation-actions/scripts/variables.sh \"$CHATVOLT_API_KEY\" \"$CHATVOLT_CONVERSATION_ID\" list; else echo 'PULADO: defina CHATVOLT_CONVERSATION_ID'; fi",
      "expect_exit": 0 },
    { "desc": "live notes.sh list (precisa CHATVOLT_CONVERSATION_ID)",
      "cmd": "if [ -n \"${CHATVOLT_CONVERSATION_ID:-}\" ]; then ./conversation-actions/scripts/notes.sh \"$CHATVOLT_API_KEY\" \"$CHATVOLT_CONVERSATION_ID\" --action list; else echo 'PULADO: defina CHATVOLT_CONVERSATION_ID'; fi",
      "expect_exit": 0 },
    { "desc": "live export-conversation.sh --out (binário; precisa CHATVOLT_CONVERSATION_ID)",
      "cmd": "if [ -n \"${CHATVOLT_CONVERSATION_ID:-}\" ]; then ./conversation-actions/scripts/export-conversation.sh \"$CHATVOLT_API_KEY\" \"$CHATVOLT_CONVERSATION_ID\" --out /tmp/cv-live-export.bin; else echo 'PULADO: defina CHATVOLT_CONVERSATION_ID'; fi",
      "expect_exit": 0 }
  ]
}
